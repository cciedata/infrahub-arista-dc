# Standalone DC3 Infrahub: copy to .env and replace every CHANGE_ME (docs/BUILD.md step 3 shows how).
# .env is git-ignored. Never commit real values.
#
# Infrahub's own example compose file ships fixed example tokens and passwords. Do not reuse them: anyone who has read
# that file knows them. Generate fresh values (UUIDs for the two tokens and the secret key, random strings for the
# passwords), for example: python3 -c 'import uuid; print(uuid.uuid4())'

# ---- Credentials (required: docker compose stops with an error if one is missing)
INFRAHUB_INITIAL_ADMIN_TOKEN=CHANGE_ME
INFRAHUB_INITIAL_AGENT_TOKEN=CHANGE_ME
INFRAHUB_SECURITY_SECRET_KEY=CHANGE_ME
INFRAHUB_INITIAL_ADMIN_PASSWORD=CHANGE_ME
INFRAHUB_DB_PASSWORD=CHANGE_ME
INFRAHUB_BROKER_PASSWORD=CHANGE_ME
INFRAHUB_TASKMANAGER_DB_PASSWORD=CHANGE_ME

# ---- Host ports (defaults below). To run beside another Infrahub on the same machine, use the alternates:
#      DC3_INFRAHUB_PORT=8001  DC3_NEO4J_METRICS_PORT=2005  DC3_NEO4J_BACKUP_PORT=6363  DC3_RABBITMQ_METRICS_PORT=15693
DC3_INFRAHUB_PORT=8000
DC3_NEO4J_METRICS_PORT=2004
DC3_NEO4J_BACKUP_PORT=6362
DC3_RABBITMQ_METRICS_PORT=15692

# ---- Client side (scripts/bootstrap.sh). Deliberately NOT named INFRAHUB_ADDRESS / INFRAHUB_API_TOKEN: docker compose
#      reads .env too, and INFRAHUB_ADDRESS would reach the Infrahub containers.
# Address of THIS standalone instance; empty = http://localhost:<DC3_INFRAHUB_PORT>.
DC3_INFRAHUB_ADDRESS=
# API token for the scripts; empty = INFRAHUB_INITIAL_ADMIN_TOKEN.
DC3_INFRAHUB_API_TOKEN=
