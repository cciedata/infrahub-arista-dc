{# DC3 server leaf (Arista EOS 4.36.2F) startup-config.
   MLAG pair L1-L2 (MLAG + shared VTEP), ESI members L3-L10 and single leaves L11-L20 (own VTEP).
   Tenants: the site's segments in the server VRFs (VLAN, VLAN-to-VNI, anycast gateway SVI, MAC-VRF), the server VRFs
   (vrf instance, ip routing vrf, VRF-to-VNI, BGP VRF) and the lab test-host access ports. No ES server ports exist
   (servers deferred), so no link tracking group is rendered (link tracking applies to ES ports only).
   Lines whose EOS syntax is not verified carry a Jinja comment that says what to check. #}
{# Decided constants: one place to change them (plans/dc3-values.md) #}
{% set mgmt_vrf = "MGMT" -%}
{% set keepalive_vrf = "VPC-KEEPALIVE" -%}                     {#- MLAG heartbeat VRF on the keepalive link -#}
{% set bfd_timers = "interval 999 min-rx 999 multiplier 3" -%}
{% set pg_underlay = "IPV4-UNDERLAY-PEERS" -%}
{% set pg_overlay = "EVPN-OVERLAY-PEERS" -%}
{% set pg_mlag = "MLAG-IPV4-UNDERLAY-PEER" -%}                 {#- iBGP to the MLAG peer over Vlan3900 -#}
{% set max_paths = "4 ecmp 4" -%}
{% set ebgp_multihop = 3 -%}
{% set route_map = "RM-CONN-2-BGP" -%}
{% set prefix_list = "PL-LOOPBACKS" -%}
{% set pl_pools = ["LOOPBACK0", "LOOPBACK1-VTEP", "ANYCAST-VTEP"] -%}  {#- Loopback1 carries the anycast VTEP on MLAG pairs, so the anycast pool is in the list -#}
{% set pl_seq_step = 10 -%}                                    {#- prefix-list seq 10, 20, 30 -#}
{% set rm_seq = 10 -%}                                         {#- route-map sequence 10 -#}
{% set vxlan_port = 4789 -%}
{% set anycast_gw_mac = "0200.0000.00aa" -%}
{% set mlag_vlan = 3900 -%}
{% set mlag_vlan_name = "VPC-BACKUP-UNDERLAY" -%}              {#- name of VLAN 3900 -#}
{% set mlag_trunk_group = "MLAGPEER" -%}                       {#- trunk group of the MLAG peer VLAN -#}
{% set heartbeat_interval = 4000 -%}
{% set dual_primary_detection = "delay 5 action errdisable all-interfaces" -%}
{% set dual_primary_recovery = "mlag 360 non-mlag 300" -%}
{% set reload_delay_mlag = 360 -%}                             {#- MLAG reload delay -#}
{% set reload_delay_non_mlag = 360 -%}                         {#- MLAG reload delay, non-MLAG ports -#}
{% set lacp_mode = "active" -%}
{% set server_vrfs = ["PROD", "DEV", "CITRIX"] -%}             {#- server VRFs -#}
{% set rt_asn = 65300 -%}                                      {#- route targets 65300:<VNI> -#}
{% set svi_mtu = 9214 -%}
{% macro peer31(cidr) %}{% set o = cidr.split("/")[0].split(".") %}{% set last = o[3] | int %}{{ o[:3] | join(".") }}.{{ last + 1 if last % 2 == 0 else last - 1 }}{% endmacro -%}
{# Values from the graph #}
{% set device = data.DcimDevice.edges[0].node -%}
{% set asn = device.asn.node.asn.value -%}
{% set site_name = device.location.node.name.value -%}
{% set interfaces = device.interfaces.edges | map(attribute="node") | list -%}
{% set physical = interfaces | selectattr("__typename", "equalto", "InterfacePhysical") | list -%}
{% set virtual = interfaces | selectattr("__typename", "equalto", "InterfaceVirtual") | list -%}
{% set lo0 = virtual | selectattr("name.value", "equalto", "Loopback0") | list | first -%}
{% set lo1 = virtual | selectattr("name.value", "equalto", "Loopback1") | list | first -%}
{% set lo2 = virtual | selectattr("name.value", "equalto", "Loopback2") | list | first -%}  {#- per-switch VTEP address, MLAG VTEP members only -#}
{% set mgmt = physical | selectattr("role.value", "equalto", "management") | list | first -%}
{% set core_all = physical | selectattr("role.value", "equalto", "core") | list -%}
{% set eth_all = physical | selectattr("role.value", "in", ["core", "vpc_keepalive", "vpc_peer_link", "access"]) | list -%}
{% set eth_names = eth_all | map(attribute="name.value") | list | sort_interface_list -%}
{% set core_names = core_all | map(attribute="name.value") | list | sort_interface_list -%}
{% set pair = device.switch_pair.node -%}
{# The site's segments in the server VRFs: every server leaf carries every site segment of those VRFs #}
{% set segs = device.location.node.segments.edges | map(attribute="node") | selectattr("vrf.node.name.value", "in", server_vrfs) | list | sort(attribute="vlan_id.value") -%}
{% set vrf_ns = namespace(items=[]) -%}
{% for name in segs | map(attribute="vrf.node.name.value") | unique | list | sort %}{% set vrf_ns.items = vrf_ns.items + [(segs | selectattr("vrf.node.name.value", "equalto", name) | list | first).vrf.node] %}{% endfor -%}
{% set vrfs = vrf_ns.items -%}
{% set is_mlag = pair is not none and pair.__typename == "FabricVpcDomain" -%}
{# Device name -> (name, ASN, Loopback0 IP), from FabricAutonomousSystem.devices #}
{% set as_ns = namespace(rows=[]) -%}
{% for a in data.FabricAutonomousSystem.edges | map(attribute="node") %}{% for d in a.devices.edges | map(attribute="node") %}{% set los = d.interfaces.edges | map(attribute="node") | selectattr("name.value", "equalto", "Loopback0") | list %}{% set as_ns.rows = as_ns.rows + [(d.name.value, a.asn.value, (los[0].ip_addresses.edges[0].node.address.value | ipaddress_interface("ip") | string) if los and los[0].ip_addresses.edges else none)] %}{% endfor %}{% endfor -%}
{# Underlay neighbors: other address of each core /31; peer device = first word of the description #}
{% set ul_ns = namespace(rows=[], spines=[]) -%}
{% for name in core_names %}{% set intf = core_all | selectattr("name.value", "equalto", name) | list | first %}{% set peer_name = intf.description.value.split(" ")[0] %}{% set ul_ns.rows = ul_ns.rows + [(peer31(intf.ip_addresses.edges[0].node.address.value), peer_name)] %}{% if peer_name not in ul_ns.spines %}{% set ul_ns.spines = ul_ns.spines + [peer_name] %}{% endif %}{% endfor -%}
{% set ov_ns = namespace(rows=[], asns=[]) -%}
{% for s in ul_ns.spines %}{% set row = as_ns.rows | selectattr("0", "equalto", s) | list | first %}{% set ov_ns.rows = ov_ns.rows + [row] %}{% if row[1] not in ov_ns.asns %}{% set ov_ns.asns = ov_ns.asns + [row[1]] %}{% endif %}{% endfor -%}
{% set spine_asn = ov_ns.asns | first -%}
{# Prefix-list entries: the source prefixes of the DC3 loopback / VTEP pools #}
{% set pl_ns = namespace(items=[]) -%}
{% for suffix in pl_pools %}{% set pool = data.CoreIPAddressPool.edges | map(attribute="node") | selectattr("name.value", "equalto", site_name ~ "-" ~ suffix) | list | first %}{% for r in pool.resources.edges %}{% set pl_ns.items = pl_ns.items + [r.node.prefix.value] %}{% endfor %}{% endfor -%}
{# Values derived by rule #}
{% set lo0_addr = lo0.ip_addresses.edges[0].node.address.value -%}
{% set router_id = lo0_addr | ipaddress_interface("ip") -%}
{% set mgmt_addr = mgmt.ip_addresses.edges[0].node.address.value -%}
{% set mgmt_gw = mgmt_addr | ipaddress_interface("network") | string | get_first_usable -%}
{% if is_mlag -%}
{% set peer = pair.members.edges | map(attribute="node") | rejectattr("name.value", "equalto", device.name.value) | list | first -%}
{% set peer_keepalive_ip = peer.interfaces.edges[0].node.ip_addresses.edges[0].node.address.value | ipaddress_interface("ip") -%}
{% set keepalive = physical | selectattr("role.value", "equalto", "vpc_keepalive") | list | first -%}
{% set svi = virtual | selectattr("role.value", "equalto", "vpc_backup") | list | first -%}
{% set svi_addr = svi.ip_addresses.edges[0].node.address.value -%}
{% set peer_svi_ip = peer31(svi_addr) -%}
{% set po = interfaces | selectattr("__typename", "equalto", "InterfacePortChannel") | selectattr("role.value", "equalto", "vpc_peer_link") | list | first -%}
{% set po_number = po.name.value | replace("Port-Channel", "") -%}
{% endif -%}
{# Loopback1 = VTEP source. On MLAG VTEP members it has no address in the data (one address per
   interface in the schema); the pair's anycast VTEP (FabricVpcDomain.anycast_vtep) is rendered there, and Loopback2
   carries the switch's own address. Elsewhere Loopback1 carries the own address. #}
{% if is_mlag and pair.anycast_vtep.node is not none -%}
{% set vtep_addr = pair.anycast_vtep.node.address.value -%}
{% else -%}
{% set vtep_addr = lo1.ip_addresses.edges[0].node.address.value -%}
{% endif -%}
hostname {{ device.name.value }}
!
service routing protocols model multi-agent
!
{# MSTP, priority 8192 on every leaf and MLAG member; EOS syntax until the smoke test #}
spanning-tree mode mstp
spanning-tree mst 0 priority 8192
!
{# local AAA: eAPI user, secret filled at delivery time (lab/dc3_secrets.py) privilege 15 #}
aaa authentication login default local
aaa authorization exec default local
!
username dc3-automation privilege 15 role network-admin secret sha512 __DC3_AUTOMATION_HASH__
!
{% for seg in segs %}
vlan {{ seg.vlan_id.value }}
   name {{ seg.name.value }}
!
{% endfor %}
{% if is_mlag %}
vlan {{ mlag_vlan }}
   name {{ mlag_vlan_name }}
   trunk group {{ mlag_trunk_group }}
!
no spanning-tree vlan-id {{ mlag_vlan }}
!
{% endif %}
{% set inst_ns = namespace(names=[mgmt_vrf] + (vrfs | map(attribute="name.value") | list) + ([keepalive_vrf] if is_mlag else [])) -%}
{% for v in inst_ns.names | sort %}
vrf instance {{ v }}
!
{% endfor %}
{% if is_mlag %}
interface {{ po.name.value }}
   description {{ po.description.value }}
   switchport mode trunk
   switchport trunk group {{ mlag_trunk_group }}
!
{% endif %}
{% for name in eth_names %}{% set intf = eth_all | selectattr("name.value", "equalto", name) | list | first %}
interface {{ intf.name.value }}
   description {{ intf.description.value }}
{% if intf.role.value == "core" %}
{# EthernetN/1 names on QSFP ports, confirmed in the lab smoke test #}
   no shutdown
   mtu {{ intf.mtu.value }}
   no switchport
   ip address {{ intf.ip_addresses.edges[0].node.address.value }}
   bfd {{ bfd_timers }}
{% elif intf.role.value == "access" %}
{# Access VLAN, edge port, BPDU guard; `spanning-tree portfast` / `bpduguard enable` syntax not verified #}
   no shutdown
   switchport access vlan {{ intf.access_segment.node.vlan_id.value }}
   spanning-tree portfast
   spanning-tree bpduguard enable
{% elif intf.role.value == "vpc_keepalive" %}
{# MLAG heartbeat over a front-panel port in a non-mgmt VRF: check in the lab #}
   no shutdown
   mtu {{ intf.mtu.value }}
   no switchport
   vrf {{ keepalive_vrf }}
   ip address {{ intf.ip_addresses.edges[0].node.address.value }}
{% else %}
   no shutdown
   channel-group {{ po_number }} mode {{ lacp_mode }}
{% endif %}
!
{% endfor %}
interface {{ lo0.name.value }}
   description {{ lo0.description.value }}
   ip address {{ lo0_addr }}
!
interface {{ lo1.name.value }}
   description {{ lo1.description.value }}
   ip address {{ vtep_addr }}
!
{% if is_mlag %}
interface {{ lo2.name.value }}
   description {{ lo2.description.value }}
   ip address {{ lo2.ip_addresses.edges[0].node.address.value }}
!
{% endif %}
interface {{ mgmt.name.value }}
   description {{ mgmt.description.value }}
   vrf {{ mgmt_vrf }}
   ip address {{ mgmt_addr }}
!
{% for seg in segs %}
interface Vlan{{ seg.vlan_id.value }}
   no shutdown
   mtu {{ svi_mtu }}
   vrf {{ seg.vrf.node.name.value }}
   ip address virtual {{ seg.prefix.node.prefix.value | get_first_usable }}/{{ seg.prefix.node.prefix.value.split("/")[1] }}
!
{% endfor %}
{% if is_mlag %}
interface {{ svi.name.value }}
   description {{ svi.description.value }}
   mtu {{ svi.mtu.value }}
   no autostate
   ip address {{ svi_addr }}
!
{% endif %}
interface Vxlan1
   vxlan source-interface {{ lo1.name.value }}
   vxlan udp-port {{ vxlan_port }}
{% if is_mlag %}
{# purpose of mlag-system-id encapsulation (syntax from AVD only) #}
   vxlan virtual-router encapsulation mac-address mlag-system-id
{% endif %}
{% for seg in segs %}
   vxlan vlan {{ seg.vlan_id.value }} vni {{ seg.l2_vni.value }}
{% endfor %}
{% for vrf in vrfs %}
   vxlan vrf {{ vrf.name.value }} vni {{ vrf.l3_vni.value }}
{% endfor %}
!
ip virtual-router mac-address {{ anycast_gw_mac }}
{% if is_mlag %}
{# both ip virtual-router mac-address lines on one switch: check in the lab #}
ip virtual-router mac-address mlag-peer
{% endif %}
!
ip routing
{# AVD form #}
no ip routing vrf {{ mgmt_vrf }}
{% for vrf in vrfs %}
ip routing vrf {{ vrf.name.value }}
{% endfor %}
!
ip prefix-list {{ prefix_list }}
{% for p in pl_ns.items %}
   seq {{ loop.index * pl_seq_step }} permit {{ p }} eq 32
{% endfor %}
!
ip route vrf {{ mgmt_vrf }} 0.0.0.0/0 {{ mgmt_gw }}
!
{% if is_mlag %}
mlag configuration
   domain-id {{ pair.name.value }}
   local-interface {{ svi.name.value }}
   peer-address {{ peer_svi_ip }}
   peer-address heartbeat {{ peer_keepalive_ip }} vrf {{ keepalive_vrf }}
   peer-link {{ po.name.value }}
{# check: unit of heartbeat-interval on the 4.36.2F parser (ms per the command reference) #}
   heartbeat-interval {{ heartbeat_interval }}
{# check: errdisable spelling (syntax line says erridisable) #}
   dual-primary detection {{ dual_primary_detection }}
{# check: parser accepts the recovery delays #}
   dual-primary recovery delay {{ dual_primary_recovery }}
   reload-delay mlag {{ reload_delay_mlag }}
   reload-delay non-mlag {{ reload_delay_non_mlag }}
!
{% endif %}
route-map {{ route_map }} permit {{ rm_seq }}
   match ip address prefix-list {{ prefix_list }}
!
{# router bfd multihop syntax: AVD form, not in the manual pages read #}
router bfd
   multihop {{ bfd_timers }}
!
router bgp {{ asn }}
   router-id {{ router_id }}
{# not found in the manual pages read (AVD form) #}
   no bgp default ipv4-unicast
{# graceful-restart helper only; EOS syntax until the smoke test #}
   graceful-restart-helper
{# check: maximum-paths / ecmp ranges #}
   maximum-paths {{ max_paths }}
   neighbor {{ pg_underlay }} peer group
   neighbor {{ pg_underlay }} remote-as {{ spine_asn }}
   neighbor {{ pg_underlay }} bfd
{% if is_mlag %}
   neighbor {{ pg_mlag }} peer group
   neighbor {{ pg_mlag }} remote-as {{ asn }}
{# AVD pattern: routes from the MLAG peer resolve via Vlan3900 #}
   neighbor {{ pg_mlag }} next-hop-self
{% endif %}
   neighbor {{ pg_overlay }} peer group
   neighbor {{ pg_overlay }} remote-as {{ spine_asn }}
   neighbor {{ pg_overlay }} update-source {{ lo0.name.value }}
   neighbor {{ pg_overlay }} bfd
   neighbor {{ pg_overlay }} ebgp-multihop {{ ebgp_multihop }}
   neighbor {{ pg_overlay }} send-community
{% for ip, peer_name in ul_ns.rows %}
   neighbor {{ ip }} peer group {{ pg_underlay }}
{% endfor %}
{% if is_mlag %}
   neighbor {{ peer_svi_ip }} peer group {{ pg_mlag }}
{% endif %}
{% for row in ov_ns.rows %}
   neighbor {{ row[2] }} peer group {{ pg_overlay }}
{% endfor %}
   redistribute connected route-map {{ route_map }}
{% for seg in segs %}
   !
   vlan {{ seg.vlan_id.value }}
      rd {{ router_id }}:{{ seg.l2_vni.value }}
      route-target both {{ rt_asn }}:{{ seg.l2_vni.value }}
      redistribute learned
{% endfor %}
   !
   address-family evpn
      neighbor {{ pg_overlay }} activate
   !
   address-family ipv4
      neighbor {{ pg_underlay }} activate
{% if is_mlag %}
      neighbor {{ pg_mlag }} activate
{% endif %}
{% for vrf in vrfs %}
   !
   vrf {{ vrf.name.value }}
      rd {{ router_id }}:{{ vrf.l3_vni.value }}
      route-target import evpn {{ rt_asn }}:{{ vrf.l3_vni.value }}
      route-target export evpn {{ rt_asn }}:{{ vrf.l3_vni.value }}
      router-id {{ router_id }}
      redistribute connected
{% endfor %}
!
{# eAPI over HTTPS in VRF MGMT; login: user dc3-automation, local AAA #}
management api http-commands
   protocol https
   no shutdown
   !
   vrf {{ mgmt_vrf }}
      no shutdown
!
end
